<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WDDM HUD by pascalkeeper
    Target: Windows 10 (all builds x64) via self-contained single-file publish.
    No runtime install required. Double-click .exe only — never raw scripts as the daily path.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon />
    <AssemblyName>WddmHud</AssemblyName>
    <RootNamespace>WddmHud</RootNamespace>
    <Version>1.0.3</Version>
    <Authors>Joseph Rocco Peransi</Authors>
    <Company>pascalkeeper</Company>
    <Product>WDDM HUD by pascalkeeper</Product>
    <Description>Lightweight hybrid-graphics performance overlay for Windows 10. Offline, zero telemetry.</Description>
    <Copyright>Copyright (C) 2026 Joseph Rocco Peransi www.github.com/pascalkeeper</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <!-- Harden single-file offline ship -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hardware\DellSMM.bin">
      <LogicalName>WddmHud.Hardware.DellSMM.bin</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
